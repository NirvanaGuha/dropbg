# Public configuration for the Pro unlock. Safe to commit: these are not secrets.
# Fill these in after creating the Polar product and deploying the worker, then `npm run deploy:cf`.
VITE_POLAR_ORG_ID=
VITE_POLAR_CHECKOUT_URL=
VITE_API_BASE=https://dropbg-api.guha2clash.workers.dev

# Model hosting for the WebAssembly BiRefNet export (Cloudflare Pages caps files at 25 MiB, so models live elsewhere).
# Leave VITE_MODELS_BASE empty in dev to serve from ./models/ via the Vite dev server.
VITE_MODELS_BASE=https://nirvanaguha.github.io/dropbg-models/
VITE_WASM_MODEL=birefnet-lite-640
VITE_WASM_DTYPE=fp16
# CPU-path engine: isnet (current) or birefnet (once the WASM export is verified on a phone).
VITE_CPU_ENGINE=birefnet
